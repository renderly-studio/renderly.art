---
import Base from '../layouts/Base.astro';
const html = "<main id=\"main\">\n<span id=\"top\"></span>\n<section class=\"hx\" aria-labelledby=\"h-hero\">\n  <div class=\"hx-grid\">\n    <div class=\"hx-id\" id=\"brandHeader\">\n      <a class=\"hx-logo\" href=\"#top\" aria-label=\"Renderly Studio\"><span class=\"rmark\" aria-hidden=\"true\"></span><span class=\"hx-word\">Renderly<small>Studio</small></span></a>\n      <p class=\"hx-label\">Real-time 3D · Unity · Unreal</p>\n      <span class=\"rule\" aria-hidden=\"true\"></span>\n      <ul class=\"hx-list\"><li>Environments</li><li>Level art</li><li>Tech art</li><li>Optimization</li><li>Assets &amp; tools</li></ul>\n    </div>\n    <figure class=\"hx-main car\" aria-label=\"Hallway, real-time environment by Renderly\"><div class=\"shot slide shot-o_hs1\"></div><div class=\"shot slide shot-o_hs2\"></div><div class=\"shot slide shot-o_hs3\"></div><div class=\"shot slide shot-o_hs4\"></div><span class=\"car-bar\" aria-hidden=\"true\"></span><figcaption class=\"credit\">Hallway · Renderly</figcaption></figure>\n    <div class=\"hx-side\" aria-hidden=\"true\">\n      <figure><div class=\"shot shot-o_nakagin\"></div></figure>\n      <figure><div class=\"shot shot-o_concrete\"></div></figure>\n    </div>\n  </div>\n  <div class=\"wrap hero hx-copy\">\n    <div>\n      <p class=\"eyebrow\"><span class=\"dot\" aria-hidden=\"true\"></span>Booking projects for early 2027</p>\n      <h1 id=\"h-hero\">Environments, assets and tech art for <em>Unity</em> and <em>Unreal</em>.</h1>\n    </div>\n    <div class=\"hx-aside\">\n      <p class=\"hero-sub\">For games and VR. Level art, performance audits and optimization from a studio built on six years of shipping real-time projects.</p>\n      <div class=\"hero-ctas\"><a class=\"btn js-need\" data-need=\"Performance audit\" href=\"#custom\">Book an audit</a><a class=\"btn ghost\" href=\"#custom\">Start a project</a></div>\n      <p class=\"proof\">Games &amp; VR · Unity · Unreal</p>\n    </div>\n  </div>\n</section>\n\n<!-- 2 · SERVICES -->\n<section class=\"section\" id=\"services\" aria-labelledby=\"h-services\">\n  <div class=\"wrap\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow\">Services</p>\n      <h2 id=\"h-services\">What we can do for your project.</h2>\n      <p class=\"muted\">For game and VR teams working in Unity or Unreal. Start with an audit, or go straight to a project.</p>\n    </div>\n    <div class=\"svc-group reveal\">\n      <p class=\"svc-grp\"><span>01</span>Environments &amp; 360</p>\n      <div class=\"svc g2\">\n      <article>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l8.5 4.8v9.4L12 21.5l-8.5-4.8V7.3z\"/><path d=\"M3.5 7.3L12 12l8.5-4.7M12 12v9.5\"/></svg>\n        <div class=\"top\"><h3>Environments &amp; levels</h3><span class=\"from\">from €4k</span></div>\n        <p>Scenes and levels for games and VR, lit and optimized. Built from modular assets, so the set is easy to extend.</p>\n        <ul><li>Blockout</li><li>Level art</li><li>Modular assets</li><li>Lighting</li></ul>\n        <span class=\"arr\" aria-hidden=\"true\">→</span>\n      </article>\n      <article>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><ellipse cx=\"12\" cy=\"12\" rx=\"3.6\" ry=\"8.5\"/><path d=\"M3.5 12h17\"/></svg>\n        <div class=\"top\"><h3>360 video &amp; cinematics</h3><span class=\"from\">quoted per project</span></div>\n        <p>360 video and cinematic sequences produced in Unreal Engine, from an existing scene or built from scratch.</p>\n        <ul><li>Unreal Engine</li><li>360 video</li><li>Sequencer</li><li>Lighting</li></ul>\n        <span class=\"arr\" aria-hidden=\"true\">→</span>\n      </article>\n      </div>\n    </div>\n    <div class=\"svc-group reveal\">\n      <p class=\"svc-grp\"><span>02</span>VR</p>\n      <div class=\"svc g3\">\n      <article class=\"entry\">\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 16a8 8 0 1 1 16 0\"/><path d=\"M12 16l4.2-5\"/><circle cx=\"12\" cy=\"16\" r=\"1.1\"/><path d=\"M4 20h16\"/></svg>\n        <div class=\"top\"><h3>Performance audit</h3><span class=\"from\">from €1.2k · 5 days</span></div>\n        <p>A fixed-price review of your VR or game project: measurements, quick wins ranked by impact and a plan to reach your frame-rate target.</p>\n        <ul><li>Draw calls</li><li>Polycount</li><li>Texture memory</li><li>Lightmaps</li><li>LODs &amp; occlusion</li><li>Shaders</li></ul>\n        <p style=\"font-size:.82rem;color:var(--honey)\">Up to 3 scenes, depending on their size. Fee credited if you go ahead within 30 days.</p>\n        <span class=\"arr\" aria-hidden=\"true\">→</span>\n      </article>\n      <article>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3l9 5-9 5-9-5 9-5z\"/><path d=\"M3 12.5l9 5 9-5\"/><path d=\"M3 17l9 5 9-5\"/></svg>\n        <div class=\"top\"><h3>Optimization &amp; rescue</h3><span class=\"from\">from €4k</span></div>\n        <p>We apply the plan inside your project until it holds the target frame rate on the headset, without losing the look.</p>\n        <ul><li>Profiling</li><li>Scene cleanup</li><li>Shader &amp; lighting rework</li><li>Build checks</li></ul>\n        <span class=\"arr\" aria-hidden=\"true\">→</span>\n      </article>\n      <article>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14.7 6.3a4 4 0 0 0-5.3 5.2L3.5 17.4l3.1 3.1 5.9-5.9a4 4 0 0 0 5.2-5.3l-2.5 2.5-2.3-.5-.5-2.3z\"/></svg>\n        <div class=\"top\"><h3>Tech art &amp; tools</h3><span class=\"from\">quoted per task</span></div>\n        <p>Shaders, editor tools and pipeline fixes that keep a project fast to work in and fast to run.</p>\n        <ul><li>Shaders</li><li>Editor tools</li><li>Pipeline</li><li>Project cleanup</li></ul>\n        <span class=\"arr\" aria-hidden=\"true\">→</span>\n      </article>\n      </div>\n    </div>\n    <div class=\"svc-foot reveal\">\n      <p class=\"muted\" style=\"font-size:.92rem\">Also available as ongoing technical art support: €400/day, or a fixed number of days per month.</p>\n      <div style=\"display:flex;gap:.8rem;flex-wrap:wrap\"><a class=\"btn\" href=\"#custom\">Start a project</a><a class=\"btn ghost\" href=\"/services\">Services in detail</a></div>\n    </div>\n  </div>\n</section>\n\n<!-- 3 · PROCESS -->\n<section class=\"section\" id=\"process\" aria-labelledby=\"h-process\">\n  <div class=\"wrap\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow\">How we work</p>\n      <h2 id=\"h-process\">Clear scope, steady progress.</h2>\n    </div>\n    <div class=\"proc reveal\">\n      <div><b>01</b><h3>Brief</h3><p>You send the form. We reply within 2 working days.</p></div>\n      <div><b>02</b><h3>Audit or proposal</h3><p>Scope, timeline and a fixed quote per milestone.</p></div>\n      <div><b>03</b><h3>Blockout</h3><p>A grey-box pass to agree layout and scale before detail.</p></div>\n      <div><b>04</b><h3>Production</h3><p>Weekly captures or video and one round of changes per milestone.</p><small>Weekly builds on interactive &amp; VR projects</small></div>\n      <div><b>05</b><h3>Handover</h3><p>Clean project, docs and 15 days of fixes on delivered work.</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- 4 · BACKGROUND -->\n<section class=\"section\" id=\"work\" aria-labelledby=\"h-work\">\n  <div class=\"wrap\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow\">Background</p>\n      <h2 id=\"h-work\">Six years of shipped real-time projects.</h2>\n      <p class=\"muted\">Games and VR projects our founding artist has shipped with other studios. Credits belong to their producers.</p>\n    </div>\n    <figure class=\"wide-shot car7 reveal\" aria-label=\"Projects\"><div class=\"shot slide shot-o_s_nau\" style=\"background-position:center 40%\"><figcaption class=\"credit\">Sant Pere de Rodes VR · Unity · at Univrse</figcaption></div><div class=\"shot slide shot-o_p1\"><figcaption class=\"credit\">Miravet VR · Unreal, 360 · at Univrse</figcaption></div><div class=\"shot slide shot-o_p2\"><figcaption class=\"credit\">Miravet VR · Unity · at Univrse</figcaption></div><div class=\"shot slide shot-o_p3\"><figcaption class=\"credit\">Escaladei VR · Unreal, 360 · at Univrse</figcaption></div><div class=\"shot slide shot-o_p4\"><figcaption class=\"credit\">Escaladei VR · Unity · at Univrse</figcaption></div><div class=\"shot slide shot-o_p5\"><figcaption class=\"credit\">The Mafioso · Unreal Engine</figcaption></div><div class=\"shot slide shot-o_p6\"><figcaption class=\"credit\">Outer Ring · Fungal Forest</figcaption></div><div class=\"shot slide shot-o_p7\"><figcaption class=\"credit\">Outer Ring · Prison</figcaption></div><span class=\"car-bar\" aria-hidden=\"true\"></span></figure>\n    <div class=\"exp reveal\" aria-label=\"Experience\">\n      <div><small>Lead art · start to finish</small><b>Sant Pere de Rodes VR</b><span>12-scene VR experience · at Univrse</span></div>\n      <div><small>Environment &amp; tech art</small><b>Miravet VR</b><span>Environments, optimization, shaders, 360 · at Univrse</span></div>\n      <div><small>Environment artist</small><b>Escaladei VR</b><span>Scenes and 360 video · at Univrse</span></div>\n      <div><small>Optimization</small><b>Hotel Dracula VR</b><span>Performance and visual upgrade · at Univrse</span></div>\n      <div><small>Project cleanup</small><b>Fairy Tales VR</b><span>Full project cleanup · at Univrse</span></div>\n      <div><small>Environment</small><b>The Mafioso</b><span>A full realistic city in Unreal</span></div>\n      <div><small>Set dressing</small><b>Outer Ring</b><span>Two custom environments for an MMO: Fungal Forest and Prison</span></div>\n    </div>\n    <p class=\"muted reveal\" style=\"font-size:.78rem;margin-top:.8rem\">VR projects made at Univrse; Els Ulls de la Història produced with Layers of Reality for the Generalitat de Catalunya. Games made for their respective studios. Shown with permission.</p>\n  </div>\n</section>\n\n<!-- 5 · WHY -->\n<section class=\"section\" id=\"why\" aria-labelledby=\"h-why\">\n  <div class=\"wrap\">\n    <div class=\"concept reveal\">\n      <div class=\"concept-txt\">\n        <p class=\"eyebrow\">Why Renderly</p>\n        <h2 id=\"h-why\">Digital worldbuilding.</h2>\n        <p class=\"muted\">A visual language that combines artistic judgement, technical rigour and a passion for building worlds.</p>\n        <div class=\"why\">\n          <div><b>01</b><h3>Direct line to the work</h3><p>You talk to the people doing the work. No account managers, no hand-offs between teams.</p></div>\n          <div><b>02</b><h3>Looks right, runs well</h3><p>Built with a technical artist's eye: performance is planned in from the first blockout, not patched later.</p></div>\n          <div><b>03</b><h3>Fixed quotes, tidy handover</h3><p>A price per milestone, regular previews and a clean, documented project. Hand-finished, see the <a class=\"inline\" href=\"#ai\">AI disclosure</a>.</p></div>\n        </div>\n      </div>\n      <figure class=\"concept-img\"><div class=\"shot shot-o_wood\"></div><img class=\"vid\" alt=\"\" src=\"/img/why-parquet.webp\" loading=\"lazy\" decoding=\"async\" /><figcaption class=\"credit\">Parquet material · light study, UE 5</figcaption></figure>\n    </div>\n  </div>\n</section>\n\n<!-- 6 · LAB -->\n<section class=\"section\" id=\"lab\" aria-labelledby=\"h-lab\">\n  <div class=\"wrap\">\n    <div class=\"lab-strip reveal\" data-released=\"1\" aria-label=\"Renderly Lab releases\">\n      <span class=\"plus\">+</span><span class=\"bar\"><i></i></span>\n      <span class=\"lab-name\"><span class=\"js-labname\">Renderly Lab</span> <small class=\"lab-count js-labcount\">01 / 10</small></span><span class=\"slash\">/</span>\n      <span class=\"lab-cats\">Assets / Materials /<br>Tools / Packs</span>\n      <span class=\"lab-corner\"></span>\n    </div>\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow\">In production</p>\n      <h2 id=\"h-lab\">Packs and tools in the works.</h2>\n      <p class=\"muted\">Assets that grow out of real production work. Not for sale yet: join the list to hear when each one lands.</p>\n    </div>\n    <div class=\"rows reveal\">\n      <a class=\"row\" href=\"#updates\">\n        <span class=\"idx\">001</span>\n        <figure class=\"frame r1610 soon-art\" aria-hidden=\"true\"><svg class=\"soon-ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.5 19.5l6.2-9.3 4.3 5.6 3-3.9 5.5 7.6z\"/><circle cx=\"16.5\" cy=\"6\" r=\"1.7\"/></svg></figure>\n        <div><h3>Environment pack 001</h3><p>A modular environment kit with a lit demo map for each engine. First release in 2027.</p><p class=\"meta\">UE 5 · Unity 6 URP</p></div>\n        <div class=\"end\"><span class=\"tag\">2027</span><span class=\"link\">Get notified →</span></div>\n      </a>\n      <a class=\"row\" href=\"#updates\">\n        <span class=\"idx\">002</span>\n        <figure class=\"frame r1610 soon-art\" aria-hidden=\"true\"><svg class=\"soon-ico\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z\"/><path d=\"M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z\"/></svg></figure>\n        <div><h3>Incoming: VFX &amp; shaders</h3><p>Real-time effects and shader tools for Unity and Unreal, built from production work.</p><p class=\"meta\">VFX · Shaders · UE 5 · Unity 6</p></div>\n        <div class=\"end\"><span class=\"tag\">In the works</span><span class=\"link\">Get notified →</span></div>\n      </a>\n      <a class=\"row free-row\" href=\"/lab/riverbed-rock-material\">\n        <span class=\"idx\">F01</span>\n        <figure class=\"frame r1610\"><div class=\"shot shot-o_riverballs\"></div></figure>\n        <div><h3>Free: Riverbed Rock Material</h3><p>A 4K tileable PBR river-stone material, ready for Unreal and Unity. Yours when you join the list.</p><p class=\"meta\">4K PBR · UE · Unity · Blender</p></div>\n        <div class=\"end\"><span class=\"tag free\">Free with the list</span><span class=\"link\">See the material →</span></div>\n      </a>\n    </div>\n    <div class=\"lab-sign reveal\" id=\"updates\">\n      <span class=\"corner tl\"></span><span class=\"corner br\"></span>\n      <div>\n        <h3 style=\"font-size:1.3rem\">Hear when the packs land.</h3>\n        <p class=\"muted\" style=\"margin-top:.4rem;font-size:.95rem\">One email per release, plus the free 4K material.</p>\n      </div>\n      <form class=\"signup js-signup\" novalidate>\n        <div class=\"hide-on-sent\">\n          <label for=\"email-end\" style=\"position:absolute;left:-999px\">Email address</label>\n          <div class=\"signup-row\"><input id=\"email-end\" type=\"email\" name=\"email\" placeholder=\"you@studio.com\" autocomplete=\"email\" required /><button class=\"btn\" type=\"submit\">Join the list</button></div>\n        </div>\n        <label class=\"consent hide-on-sent\"><input type=\"checkbox\" name=\"consent\" required /> <span>I agree to receive release emails from Renderly Studio. Unsubscribe anytime. See the <a href=\"/privacy\">privacy policy</a>.</span></label>\n        <p class=\"err\" role=\"alert\">Add a valid email and tick the box to join.</p>\n        <div class=\"form-ok\" role=\"status\"><b>Thanks.</b> Your email app should have opened. Send the message and you are on the list.</div>\n      </form>\n    </div>\n  </div>\n</section>\n\n\n\n\n\n<!-- 9 · FAQ -->\n<section class=\"section\" id=\"faq\" aria-labelledby=\"h-faq\">\n  <div class=\"wrap faq\">\n    <div class=\"section-head reveal\">\n      <p class=\"eyebrow\">FAQ</p>\n      <h2 id=\"h-faq\">Before we start.</h2>\n      <p class=\"muted\">Something else? Write to <a class=\"inline js-copy\" href=\"#\" data-email=\"hello@renderly.art\">hello@renderly.art</a></p>\n    </div>\n    <div class=\"faq-list reveal\">\n        <details><summary>Which engines and platforms do you work with?</summary><p>Unity (URP and Built-in) and Unreal Engine 5. Games on PC and consoles, and VR on standalone headsets and PC VR. For other targets, ask.</p></details>\n        <details><summary>How does the performance audit work?</summary><p>You share the project or a build. In about five working days you get a written report with measurements, the quick wins ranked by impact and an estimate to reach your target. The base audit covers up to 3 scenes, depending on their size; larger projects are quoted by scene count. If you go ahead with the optimization within 30 days, the audit fee is credited.</p></details>\n        <details><summary>Do I get builds during the project?</summary><p>On interactive and VR projects, yes: a build every week. For an environment or level on its own you get weekly captures or video, and the full project at each milestone.</p></details>\n        <details><summary>Who owns the assets made for my project?</summary><p>Anything specific to your project (your brand, characters, locations) is yours. Generic pieces such as rocks, foliage or materials come with a perpetual licence to use them in your project, and Renderly may reuse them. Full exclusivity is available for an extra fee.</p></details>\n        <details><summary>Do you sign NDAs and work with our tools?</summary><p>Yes. We can work inside your repository and version control (Git, Unity Version Control or Perforce) and follow your naming and folder rules.</p></details>\n        <details><summary>Is anything AI-generated?</summary><p>No asset is 100% AI-generated. AI tools help with iteration and repetitive steps; every asset is modelled, textured and finished by hand.</p></details>\n        <details><summary>When will the packs be available?</summary><p>They are in production. Join the list in the Lab to hear when each one lands. They will be sold on Fab, Unity Asset Store and Gumroad under each store's licence.</p></details>\n    </div>\n  </div>\n</section>\n\n<!-- 10 · START A PROJECT -->\n<section class=\"section\" id=\"custom\" aria-labelledby=\"h-custom\">\n  <div class=\"wrap cw\">\n    <div class=\"cw-side reveal\">\n      <div class=\"section-head\" style=\"margin-bottom:0\">\n        <p class=\"eyebrow\">Start a project</p>\n        <h2 id=\"h-custom\">Tell us about your project.</h2>\n        <p class=\"muted\">Environments, 360 video, VR audits, optimization or tech art. A small number of projects at a time, so each one gets full attention.</p>\n      </div>\n      <div class=\"cw-facts\">\n        <span class=\"tag hot\"><span class=\"dot\" aria-hidden=\"true\"></span>1–2 projects per quarter</span>\n        <span class=\"tag\">Next start: Jan 2027</span>\n        <span class=\"tag\">Audits from €1.2k</span><span class=\"tag\">Projects from €4k</span>\n      </div>\n      <p class=\"cw-next\">You get a reply within 2 working days with questions or a first scope. Prefer email? <a class=\"link js-copy\" href=\"#\" data-email=\"hello@renderly.art\">hello@renderly.art</a></p>\n    </div>\n    <form class=\"cform reveal js-enquiry\" novalidate>\n      <div class=\"field\"><label for=\"cf-name\">Name</label><input id=\"cf-name\" name=\"name\" autocomplete=\"name\" required /></div>\n      <div class=\"field\"><label for=\"cf-email\">Email</label><input id=\"cf-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required /></div>\n      <div class=\"field\"><label for=\"cf-type\">What you need</label><select id=\"cf-type\" name=\"type\"><option>Performance audit</option><option>Optimization &amp; rescue</option><option>Environment / level</option><option>360 video / cinematic</option><option>Tech art (shaders, tools)</option><option>Project versions / adaptations</option><option>Ongoing support</option><option>Something else</option></select></div>\n      <div class=\"field\"><label for=\"cf-engine\">Engine &amp; version</label><select id=\"cf-engine\" name=\"engine\"><option>Unreal Engine 5</option><option>Unity 6</option><option>Unity 2022 LTS</option><option>Both engines</option><option>Other</option></select></div>\n      <div class=\"field\"><label for=\"cf-budget\">Budget</label><select id=\"cf-budget\" name=\"budget\"><option>€1.2k – 3k</option><option>€3k – 6k</option><option>€6k – 10k</option><option>€10k +</option><option>Not sure yet</option></select></div>\n      <div class=\"field\"><label for=\"cf-when\">Timeline</label><input id=\"cf-when\" name=\"when\" placeholder=\"e.g. delivery by March\" /></div>\n      <div class=\"field full grow\"><label for=\"cf-msg\">Project &amp; references</label><textarea id=\"cf-msg\" name=\"msg\" placeholder=\"What it is, style, links to references…\" required></textarea></div>\n      <label class=\"consent full\"><input type=\"checkbox\" name=\"consent\" required /> <span>I agree that Renderly Studio uses these details to answer my enquiry, as described in the <a href=\"/privacy\">privacy policy</a>.</span></label>\n      <p class=\"err full\" role=\"alert\">Fill in name, a valid email and the project description, and tick the box.</p>\n      <div class=\"full hide-on-sent\" style=\"display:flex;gap:1rem;align-items:center;flex-wrap:wrap\"><button class=\"btn\" type=\"submit\">Send enquiry</button><a class=\"link js-copy\" href=\"#\" data-email=\"hello@renderly.art\">Or copy hello@renderly.art</a></div>\n      <div class=\"form-ok full\" role=\"status\"><b>Thanks.</b> Your email app should have opened with the enquiry. If not, write to hello@renderly.art.</div>\n    </form>\n  </div>\n</section>\n</main>\n<div class=\"mbar\" id=\"mbar\" aria-hidden=\"true\"><span>Booking early 2027</span><a class=\"btn\" href=\"#custom\" tabindex=\"-1\">Start a project</a></div>\n\n";
---
<Base title="Renderly Studio · Environments, assets and tech art for Unity and Unreal" description="Environments, level art, performance audits, optimization and tech art for games and VR in Unity and Unreal Engine, by a real-time 3D studio in Barcelona." path="/" home>
<Fragment set:html={html} />
</Base>
