<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Renderly Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body { width: 100%; height: 100%; }

    body {
      background-color: #0a0a0a;
      font-family: 'Space Grotesk', sans-serif;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
      color: #fff;
    }

    canvas#bg {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .vignette {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: radial-gradient(ellipse at center, transparent 50%, rgba(10,10,10,0.4) 90%, rgba(10,10,10,0.7) 100%);
    }

    .content {
      position: relative;
      z-index: 3;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      padding: 2rem;
      text-align: center;
    }

    .logo {
      width: clamp(280px, 45vw, 460px);
      opacity: 0;
      animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s forwards;
      filter: drop-shadow(0 0 35px rgba(232, 185, 72, 0.15));
    }

    .meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      opacity: 0;
      animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 1s forwards;
    }

    .divider {
      width: 2px;
      height: 32px;
      background: linear-gradient(to bottom, transparent, rgba(232, 185, 72, 0.5), transparent);
    }

    .label {
      font-size: 18px;
      font-weight: 500;
      letter-spacing: 0.5em;
      text-transform: uppercase;
      color: #e8b948;
      padding-left: 0.5em;
    }

    .footer {
      position: fixed;
      bottom: 2.5rem;
      left: 0;
      right: 0;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      padding: 0 3rem;
      font-size: 0.7 rem;
      font-weight: 300;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #555;
      opacity: 0;
      animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 1.4s forwards;
    }

    .footer a {
      color: #777;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer a:hover { color: #e8b948; }

    @keyframes rise {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
      .footer { padding: 0 1.5rem; flex-direction: column; gap: 0.5rem; align-items: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; opacity: 1 !important; }
    }
  </style>
</head>
<body>
  <canvas id="bg"></canvas>
  <div class="vignette"></div>

  <div class="content">
    <img class="logo" src="/logo.png" alt="Renderly Studio" />
    <div class="meta">
      <div class="divider"></div>
      <span class="label">Coming Soon</span>
    </div>
  </div>

  <div class="footer">
    <span>Renderly Studio © 2025</span>
    <a href="mailto:hello@renderly.art">hello@renderly.art</a>
  </div>

  <script>
    // ---- Ajustes del oleaje (calíbralos a mano) ----------------------------
    const CONFIG = {
      img:       "/fingerprint.jpg", // imagen en public/  ->  servida en la raíz
      amp:       0.015,  // amplitud del oleaje (sube para más movimiento)
      flowScale: 3.0,    // escala del flujo (más alto = remolinos más pequeños)
      speed:     0.185,    // velocidad
      rippleAmp: 0.004,  // micro-rizado fino
      dprCap:    2.0
    };
    // ------------------------------------------------------------------------

    const canvas = document.getElementById("bg");
    const gl = canvas.getContext("webgl", { antialias: true, alpha: false })
            || canvas.getContext("experimental-webgl");

    if (gl) {
      const reduceMotion = window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const VERT = `attribute vec2 aPos; void main(){ gl_Position = vec4(aPos,0.,1.); }`;
      const FRAG = `
        precision highp float;
        uniform vec2  uRes;
        uniform float uTime, uImgAspect, uAmp, uFlow, uRipple;
        uniform sampler2D uTex;

        float hash(vec2 p){ p = fract(p*vec2(123.34,456.21)); p += dot(p,p+45.32); return fract(p.x*p.y); }
        float vnoise(vec2 p){
          vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f);
          float a=hash(i), b=hash(i+vec2(1.,0.)), c=hash(i+vec2(0.,1.)), d=hash(i+vec2(1.,1.));
          return mix(mix(a,b,u.x), mix(c,d,u.x), u.y);
        }
        float fbm(vec2 p){ float v=0.,a=0.5; for(int i=0;i<4;i++){ v+=a*vnoise(p); p=p*2.03+11.1; a*=0.5; } return v; }

        void main(){
          vec2 uv = gl_FragCoord.xy / uRes;
          float va = uRes.x / uRes.y;
          vec2 s = (va < uImgAspect) ? vec2(va/uImgAspect, 1.0) : vec2(1.0, uImgAspect/va);
          vec2 st = (uv - 0.5) * s + 0.5;

          float t = uTime;
          vec2 fp = st * uFlow;
          vec2 q = vec2(fbm(fp + vec2(0.0, t*0.12)), fbm(fp + vec2(5.2,1.3) - t*0.10));
          vec2 disp = (q - 0.5) * uAmp;
          disp += vec2(sin((st.y*40.0)+t*1.3), cos((st.x*40.0)-t*1.1)) * uRipple;

          gl_FragColor = vec4(max(texture2D(uTex, st + disp).rgb, 0.0), 1.0);
        }
      `;

      const compile = (type, src) => {
        const sh = gl.createShader(type);
        gl.shaderSource(sh, src); gl.compileShader(sh);
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(sh));
        return sh;
      };
      const prog = gl.createProgram();
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog); gl.useProgram(prog);

      const vbo = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
      const aPos = gl.getAttribLocation(prog, "aPos");
      gl.enableVertexAttribArray(aPos);
      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

      const U = n => gl.getUniformLocation(prog, n);
      const uRes = U("uRes"), uTime = U("uTime"), uImgAspect = U("uImgAspect");
      gl.uniform1f(U("uAmp"), CONFIG.amp);
      gl.uniform1f(U("uFlow"), CONFIG.flowScale);
      gl.uniform1f(U("uRipple"), CONFIG.rippleAmp);
      gl.uniform1i(U("uTex"), 0);

      const tex = gl.createTexture();
      const img = new Image();
      img.onload = () => {
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.uniform1f(uImgAspect, img.naturalWidth / img.naturalHeight);
        start();
      };
      img.onerror = () => console.error("No se pudo cargar", CONFIG.img);
      img.src = CONFIG.img;

      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, CONFIG.dprCap);
        const w = Math.floor(window.innerWidth*dpr), h = Math.floor(window.innerHeight*dpr);
        if (canvas.width !== w || canvas.height !== h){ canvas.width=w; canvas.height=h; gl.viewport(0,0,w,h); }
        gl.uniform2f(uRes, w, h);
      };
      window.addEventListener("resize", resize);

      function start(){
        resize();
        const t0 = performance.now();
        const frame = (now) => {
          resize();
          gl.uniform1f(uTime, reduceMotion ? 0.0 : (now - t0)*0.001*CONFIG.speed);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          if (!reduceMotion) requestAnimationFrame(frame);
        };
        if (reduceMotion){ gl.uniform1f(uTime, 0.0); gl.drawArrays(gl.TRIANGLES, 0, 3); }
        else requestAnimationFrame(frame);
      }
    }
  </script>
</body>
</html>
