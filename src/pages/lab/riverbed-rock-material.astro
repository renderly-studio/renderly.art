---
import Base from '../../layouts/Base.astro';
const html = "<main id=\"main\"><section class=\"page page-wide page-standalone\" id=\"free-riverbed\" aria-labelledby=\"h-fr\">\n  <div class=\"page-inner\">\n    <p class=\"mono\" style=\"font-size:.72rem;color:var(--ash)\"><a href=\"/\">Home</a> / <a href=\"/#lab\">Lab</a> / Riverbed Rock Material</p>\n    <span class=\"tag free\" style=\"margin-top:1rem;color:var(--honey);border-color:var(--honey-dim)\">Free with the list</span>\n    <h1 id=\"h-fr\" style=\"font-size:clamp(2rem,4.6vw,3rem);margin:.8rem 0 .4rem\">Riverbed Rock Material</h1>\n    <p class=\"muted\" style=\"max-width:42rem;font-size:1.05rem\">A 4K tileable PBR river-stone material built in Substance Designer and tested in Unreal and Unity. Ready-made textures, plus a parametric .sbsar with 7 colour presets.</p>\n    <div class=\"fr-grid\">\n      <div class=\"fr-media wide\"><img class=\"vid\" alt=\"\" src=\"/img/riverbed-variants.webp\" loading=\"lazy\" decoding=\"async\" /></div>\n      <div class=\"fr-media sq\"><img class=\"vid\" alt=\"\" src=\"/img/riverbed-turnaround.webp\" loading=\"lazy\" decoding=\"async\" /></div>\n    </div>\n    <div class=\"pk-section\">\n      <h2>Tested in both engines</h2>\n      <div class=\"fr-eng\">\n        <figure class=\"fr-media\"><img src=\"/img/riverbed-unity.jpg\" alt=\"Riverbed rock material in Unity 6 with URP\" loading=\"lazy\" /><figcaption class=\"credit\">Unity 6 · URP</figcaption></figure>\n        <figure class=\"fr-media\"><img src=\"/img/riverbed-unreal.jpg\" alt=\"Riverbed rock material in Unreal Engine 5\" loading=\"lazy\" /><figcaption class=\"credit\">Unreal Engine 5</figcaption></figure>\n        <figure class=\"fr-media sq\"><img class=\"vid\" src=\"/img/riverbed-painter.webp\" alt=\"Tweaking the material parameters in Substance 3D Painter\" loading=\"lazy\" /><figcaption class=\"credit\">Parametric · Substance 3D Painter</figcaption></figure>\n      </div>\n    </div>\n    <div class=\"pk-section\">\n      <h2>What you get</h2>\n      <dl class=\"specs\">\n        <dt>Resolution</dt><dd>4K, tileable</dd>\n        <dt>Textures</dt><dd>1 colour, ready to use (PNG)</dd><dt>Colour presets</dt><dd>7 in the .sbsar, plus parametric controls for many more</dd>\n        <dt>Maps</dt><dd>Base colour, normal, height, roughness, AO</dd>\n        <dt>Engines</dt><dd>Unreal Engine 5 · Unity 6 (URP) · Blender</dd>\n        <dt>Source</dt><dd>Substance Designer · parametric .sbsar</dd>\n        <dt>Licence</dt><dd>Free for personal and commercial projects; no resale as an asset</dd>\n      </dl>\n    </div>\n    <div class=\"pk-section\">\n      <h2>Texture maps</h2>\n      <div class=\"fr-media\"><img alt=\"Height, base colour, normal and roughness maps of the riverbed rock material\" src=\"/img/riverbed-maps.jpg\" loading=\"lazy\" decoding=\"async\" /></div>\n    </div>\n    <div class=\"pk-section\">\n      <div class=\"lab-sign\">\n        <span class=\"corner tl\"></span><span class=\"corner br\"></span>\n        <div><h3 style=\"font-size:1.3rem\">Get it free.</h3><p class=\"muted\" style=\"margin-top:.4rem;font-size:.95rem\">Join the list and the download link arrives in your inbox.</p></div>\n        <form class=\"signup js-signup\" novalidate>\n          <div class=\"hide-on-sent\">\n            <label for=\"email-fr\" style=\"position:absolute;left:-999px\">Email address</label>\n            <div class=\"signup-row\"><input id=\"email-fr\" type=\"email\" name=\"email\" placeholder=\"you@studio.com\" autocomplete=\"email\" required /><button class=\"btn\" type=\"submit\">Send me the material</button></div>\n          </div>\n          <label class=\"consent hide-on-sent\"><input type=\"checkbox\" name=\"consent\" required /> <span>I agree to receive release emails from Renderly Studio. Unsubscribe anytime. See the <a href=\"/privacy\">privacy policy</a>.</span></label>\n          <p class=\"err\" role=\"alert\">Add a valid email and tick the box to join.</p>\n          <div class=\"form-ok\" role=\"status\"><b>Thanks.</b> Your email app should have opened. Send the message and the material follows by email.</div>\n        </form>\n      </div>\n    </div>\n  </div>\n</section></main>";
---
<Base title="Free Riverbed Rock Material · Renderly Lab" description="A free 4K tileable PBR river-stone material with a parametric .sbsar (7 colour presets), made in Substance Designer and tested in Unreal and Unity." path="/lab/riverbed-rock-material">
<Fragment set:html={html} />
</Base>
