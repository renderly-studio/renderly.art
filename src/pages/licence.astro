const html = "<main id=\"main\"><section class=\"page page-standalone\" id=\"licence\" aria-labelledby=\"h-li\">\n  <div class=\"page-inner\">\n    <p class=\"eyebrow\">Legal</p>\n    <h1 id=\"h-li\">Licences &amp; copyright</h1>\n    <ul>\n      <li><b>Fab:</b> assets are licensed under the Fab Standard License or Personal License, as chosen at checkout.</li>\n      <li><b>Unity Asset Store:</b> assets are licensed under the Unity Asset Store EULA.</li>\n      <li><b>Gumroad:</b> assets are licensed under the Renderly licence included in each download.</li>\n      <li><b>Free downloads:</b> may be used in personal and commercial projects; they may not be resold or redistributed as assets.</li>\n    </ul>\n    <h2>Client work</h2>\n    <ul>\n      <li><b>Project-specific content</b> (the client's brand, characters, locations and anything made only for them) belongs to the client once paid.</li>\n      <li><b>Generic assets</b> made during a project (rocks, foliage, materials, modular pieces) are licensed to the client for perpetual use in their projects, non-exclusively. Renderly Studio may reuse them.</li>\n      <li><b>Full exclusivity</b> over generic assets is available for an additional fee, agreed in the quote.</li>\n    </ul>\n    <p>For any other use of content from this site, ask first at hello@renderly.art.</p>\n  </div>\n</section></main>";
---
<Base title="Licences & copyright · Renderly Studio" description="Licences for Renderly Studio assets and client work." path="/licence">
<Fragment set:html={html} />
</Base>
