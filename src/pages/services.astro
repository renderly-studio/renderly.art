---
import Base from '../layouts/Base.astro';
const html = "<main id=\"main\"><section class=\"page page-wide page-standalone\" id=\"services-page\" aria-labelledby=\"h-sv\">\n  <div class=\"page-inner\">\n    <p class=\"mono\" style=\"font-size:.72rem;color:var(--ash)\"><a href=\"/\">Home</a> / Services</p>\n    <h1 id=\"h-sv\" style=\"font-size:clamp(2rem,4.6vw,3rem);margin:.8rem 0 .4rem\">Environments, assets and tech art for Unity and Unreal.</h1>\n    <p class=\"muted\" style=\"max-width:44rem;font-size:1.05rem\">For game and VR teams. Fixed quotes, regular previews and a direct line to the people doing the work, from brief to handover.</p>\n    <div class=\"svc-detail\">\n      <p class=\"svc-grp\"><span>01</span>Environments &amp; 360</p>\n      <article><div><h3>Environments &amp; levels</h3><span class=\"from\">from €4k</span></div>\n        <dl><dt>For</dt><dd>Games and VR experiences.</dd>\n            <dt>We do</dt><dd>Blockout, modular assets, level art and lighting in Unity or Unreal.</dd>\n            <dt>You get</dt><dd>Clean, optimized scenes. Weekly captures or video; weekly builds when the project is interactive or VR.</dd></dl></article>\n      <article><div><h3>360 video &amp; cinematics</h3><span class=\"from\">quoted per project</span></div>\n        <dl><dt>For</dt><dd>VR experiences, museums, trailers and presentations.</dd>\n            <dt>We do</dt><dd>360 video and cinematic sequences in Unreal Engine, from an existing scene or built from scratch, ready to drop into a Unity or Unreal project.</dd>\n            <dt>You get</dt><dd>Rendered video at the resolution and format your player needs, plus the Unreal project.</dd></dl></article>\n      <p class=\"svc-grp\"><span>02</span>VR</p>\n      <article><div><h3>Performance audit</h3><span class=\"from\">from €1.2k · 5 working days</span></div>\n        <dl><dt>For</dt><dd>VR and game projects that drop frames, overheat or fail a platform or venue performance check.</dd>\n            <dt>Scope</dt><dd>Up to 3 scenes or levels, depending on their size. Larger projects are quoted by scene count.</dd>\n            <dt>We look at</dt><dd>Draw calls and batching, polycount, texture memory, lightmaps and baking, LODs and occlusion, shader cost, overdraw.</dd>\n            <dt>You get</dt><dd>A written report with measurements, the quick wins ranked by impact, and an estimate to reach your target. The fee is credited if you go ahead with the optimization within 30 days.</dd></dl></article>\n      <article><div><h3>Optimization &amp; rescue</h3><span class=\"from\">from €4k</span></div>\n        <dl><dt>For</dt><dd>Teams that need the fixes done, not just listed.</dd>\n            <dt>We do</dt><dd>Profiling, scene and asset cleanup, shader and lighting rework, LOD and occlusion setup, build checks on the target device.</dd>\n            <dt>You get</dt><dd>A project that holds the target frame rate, with the visual quality preserved and the changes documented.</dd></dl></article>\n      <article><div><h3>Tech art &amp; tools</h3><span class=\"from\">quoted per task</span></div>\n        <dl><dt>For</dt><dd>Projects that need shaders, editor tools or pipeline fixes.</dd>\n            <dt>We do</dt><dd>Custom shaders, editor tools, pipeline fixes and project cleanup.</dd>\n            <dt>You get</dt><dd>A project that is faster to work in and faster to run, with the tools documented.</dd></dl></article>\n      <p class=\"svc-grp\"><span>+</span>Ongoing</p>\n      <article><div><h3>Ongoing support</h3><span class=\"from\">€400/day · €220 half day</span></div>\n        <dl><dt>For</dt><dd>Studios that need a technical artist part-time: reviews, tools, shaders, pipeline.</dd>\n            <dt>You get</dt><dd>A fixed number of days per month and a weekly summary.</dd></dl></article>\n    </div>\n    <p class=\"muted\" style=\"font-size:.78rem;margin-top:1rem\">All prices excl. VAT.</p>\n\n    <div class=\"pk-section\">\n      <h2>Technical breakdown</h2>\n      <div class=\"lab-sign\" style=\"margin-top:.8rem\">\n        <span class=\"corner tl\"></span><span class=\"corner br\"></span>\n        <div><span class=\"tag\" style=\"color:var(--honey);border-color:var(--honey-dim)\">Coming soon</span><h3 style=\"font-size:1.2rem;margin-top:.7rem\">From blockout to frame rate.</h3><p class=\"muted\" style=\"margin-top:.4rem;font-size:.95rem\">A lighting and optimization breakdown of one of our own scenes: wireframe, lighting passes and the profiling behind the final result.</p></div>\n      </div>\n    </div>\n\n    <div class=\"pk-section\">\n      <h2>Background</h2>\n      <p class=\"muted\" style=\"font-size:.92rem;margin:-.4rem 0 1rem\">Games and VR projects our founding artist has shipped with other studios. Credits belong to their producers.</p>\n      <div class=\"exp\" style=\"margin-top:0\">\n        <div><small>Lead art · start to finish</small><b>Sant Pere de Rodes VR</b><span>12-scene VR experience · at Univrse</span></div>\n      <div><small>Environment &amp; tech art</small><b>Miravet VR</b><span>Environments, optimization, shaders, 360 · at Univrse</span></div>\n      <div><small>Environment artist</small><b>Escaladei VR</b><span>Scenes and 360 video · at Univrse</span></div>\n      <div><small>Optimization</small><b>Hotel Dracula VR</b><span>Performance and visual upgrade · at Univrse</span></div>\n      <div><small>Project cleanup</small><b>Fairy Tales VR</b><span>Full project cleanup · at Univrse</span></div>\n      <div><small>Environment</small><b>The Mafioso</b><span>A full realistic city in Unreal</span></div>\n      <div><small>Set dressing</small><b>Outer Ring</b><span>Two custom environments for an MMO: Fungal Forest and Prison</span></div>\n        <div><small>360 video</small><b>Colònia Sedó VR</b><span>360 sequence in Unreal · at Univrse</span></div>\n      </div>\n      <p class=\"muted\" style=\"font-size:.78rem;margin-top:.8rem\">VR projects made at Univrse; games made for their respective studios. Shown with permission. More on <a class=\"inline\" href=\"https://www.artstation.com/renderly\" target=\"_blank\" rel=\"noopener\">ArtStation ↗</a></p>\n    </div>\n    <div class=\"pk-section\" style=\"display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;border-top:1px solid var(--hairline);padding-top:1.4rem\">\n      <p style=\"margin:0;font-size:1.1rem\">Have a project in Unity or Unreal?</p>\n      <div style=\"display:flex;gap:.8rem;flex-wrap:wrap\"><a class=\"btn js-need\" data-need=\"Performance audit\" href=\"/#custom\">Book an audit</a><a class=\"btn ghost\" href=\"/#custom\">Start a project</a></div>\n    </div>\n  </div>\n</section></main>";
---
<Base title="VR & real-time services · Renderly Studio" description="Performance audits, optimization, environments, levels and tech art for Unity and Unreal, for game and VR teams." path="/services">
<Fragment set:html={html} />
</Base>
