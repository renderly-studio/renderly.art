---
import Base from '../layouts/Base.astro';
const html = "<main id=\"main\"><section class=\"page page-wide page-standalone\" id=\"services-page\" aria-labelledby=\"h-sv\">\n  <div class=\"page-inner\">\n    <p class=\"mono\" style=\"font-size:.72rem;color:var(--ash)\"><a href=\"/\">Home</a> / Services</p>\n    <h1 id=\"h-sv\" style=\"font-size:clamp(2rem,4.6vw,3rem);margin:.8rem 0 .4rem\">Environments, assets and tech art for Unity and Unreal.</h1>\n    <p class=\"muted\" style=\"max-width:44rem;font-size:1.05rem\">For game and VR teams. Fixed quotes, regular previews, and one person responsible from brief to handover.</p>\n    <div class=\"svc-detail\">\n      <article><div><h3>Performance audit</h3><span class=\"from\">from €1.2k · 5 working days</span></div>\n        <dl><dt>For</dt><dd>Games and VR projects that drop frames, overheat or fail a platform or venue performance check.</dd>\n            <dt>I look at</dt><dd>Draw calls and batching, polycount, texture memory, lightmaps and baking, LODs and occlusion, shader cost, overdraw.</dd>\n            <dt>You get</dt><dd>A written report with measurements, the quick wins ranked by impact, and an estimate to reach your target. The fee is credited if you go ahead with the optimization within 30 days.</dd></dl></article>\n      <article><div><h3>Optimization &amp; rescue</h3><span class=\"from\">from €4k</span></div>\n        <dl><dt>For</dt><dd>Teams that need the fixes done, not just listed.</dd>\n            <dt>I do</dt><dd>Profiling, scene and asset cleanup, shader and lighting rework, LOD and occlusion setup, build checks on the target device.</dd>\n            <dt>You get</dt><dd>A project that holds the target frame rate, with the visual quality preserved and the changes documented.</dd></dl></article>\n      <article><div><h3>Environments &amp; levels</h3><span class=\"from\">from €4k</span></div>\n        <dl><dt>For</dt><dd>Games, VR experiences, cinematics and 360 video.</dd>\n            <dt>I do</dt><dd>Blockout, modular assets, level art and lighting in Unity or Unreal, and 360 video produced in Unreal.</dd>\n            <dt>You get</dt><dd>Clean, optimized scenes. Weekly captures or video; weekly builds when the project is interactive or VR.</dd></dl></article>\n      <article><div><h3>Tech art &amp; versions</h3><span class=\"from\">quoted per task</span></div>\n        <dl><dt>For</dt><dd>Projects that need shaders, tools or a structure that scales to new versions.</dd>\n            <dt>I do</dt><dd>Shaders, editor tools, pipeline fixes, project cleanup into a master version, adaptations for new venues or platforms.</dd>\n            <dt>You get</dt><dd>Faster, cheaper versions from one maintained project.</dd></dl></article>\n      <article><div><h3>Ongoing support</h3><span class=\"from\">by the day or month</span></div>\n        <dl><dt>For</dt><dd>Studios that need a technical artist part-time: reviews, tools, shaders, pipeline.</dd>\n            <dt>You get</dt><dd>A fixed number of days per month and a weekly summary.</dd></dl></article>\n    </div>\n\n    <div class=\"pk-section\">\n      <h2>Case study · Sant Pere de Rodes VR</h2>\n      <p class=\"mono\" style=\"font-size:.7rem;color:var(--ash);margin-bottom:1rem\">Els Ulls de la Història · Univrse with Layers of Reality, for the Generalitat de Catalunya · Lead artist</p>\n      <div class=\"case\">\n        <div>\n          <h3 style=\"font-size:1rem;font-family:var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--honey)\">Problem</h3>\n          <p style=\"margin:.4rem 0 1rem;color:#d6d2c8\">Bring the monastery to life as one continuous VR visit: twelve very different scenes, each loaded, lit and timed to the narration, running smoothly from start to end.</p>\n          <h3 style=\"font-size:1rem;font-family:var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--honey)\">Approach</h3>\n          <ul style=\"margin:.4rem 0 1rem 1.1rem;color:#d6d2c8\">\n            <li>Experience logic, timelines and triggers</li>\n            <li>Scene work and lighting across all twelve scenes</li>\n            <li>Profiling and optimization through to release</li>\n          </ul>\n          <h3 style=\"font-size:1rem;font-family:var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--honey)\">Result</h3>\n          <div class=\"kpis\" aria-label=\"Results\">\n            <div><b>12</b><span>scenes, one experience</span></div><div><b>~20 min</b><span>guided, timeline-driven</span></div><div><b>HTC · Pico</b><span>VR headsets · Unity 6.0</span></div>\n          </div>\n        </div>\n        <figure class=\"frame r169\"><img class=\"vid\" alt=\"Portal lighting sequence driven by the master timeline\" src=\"/img/santpere-portal.webp\" loading=\"lazy\" decoding=\"async\" /><figcaption class=\"credit\">Portal · lighting sequence on the timeline</figcaption></figure>\n      </div>\n      <h3 style=\"margin:1.6rem 0 .8rem\">Technical breakdown</h3>\n      <div class=\"devlog\"><div class=\"post\"><figure class=\"frame r169\"><div class=\"shot shot-o_t_state\" style=\"background-position:center top\"></div><span class=\"ph-label\">State machine</span></figure><h3>Scene loading and memory per step</h3><p>Twelve scenes loaded and unloaded in order, with the memory budget of each step in view.</p></div><div class=\"post\"><figure class=\"frame r169\"><div class=\"shot shot-o_t_scene\" style=\"background-position:center top\"></div><span class=\"ph-label\">Scene logic</span></figure><h3>Triggers, audio and guardians</h3><p>Light, audio and trigger volumes placed per scene to guide the visitor and drive events.</p></div><div class=\"post\"><figure class=\"frame r169\"><div class=\"shot shot-o_t_timeline\" style=\"background-position:center top\"></div><span class=\"ph-label\">Master timeline</span></figure><h3>The whole visit, second by second</h3><p>Scenes, narration, music, ambience and mixer snapshots sequenced on one master timeline.</p></div></div>\n    </div>\n\n    <div class=\"pk-section\">\n      <h2>Experience</h2>\n      <div class=\"exp\" style=\"margin-top:0\">\n        <div><small>Lead artist · start to finish</small><b>Sant Pere de Rodes VR</b><span>Els Ulls de la Història</span></div>\n      <div><small>Environment &amp; tech art</small><b>Miravet VR</b><span>Environments, optimization, shaders, 360</span></div>\n      <div><small>Environment artist</small><b>Escaladei VR</b><span>Scenes and 360 video</span></div>\n      <div><small>Optimization &amp; adaptations</small><b>Hotel Dracula VR</b><span>Performance and visual upgrade, venue versions</span></div>\n      <div><small>Master project</small><b>Fairy Tales VR</b><span>Full cleanup and master for faster adaptations</span></div>\n      <div><small>Environment</small><b>The Mafioso</b><span>A full realistic city in Unreal</span></div>\n      <div><small>Set dressing</small><b>Outer Ring</b><span>Two custom environments for an MMO: Fungal Forest and Prison</span></div>\n        <div><small>360 video</small><b>Colònia Sedó VR</b><span>360 sequence in Unreal</span></div>\n      </div>\n      <p class=\"muted\" style=\"font-size:.78rem;margin-top:.8rem\">VR projects made at Univrse. Shown with permission. More on <a class=\"inline\" href=\"https://www.artstation.com/renderly\" target=\"_blank\" rel=\"noopener\">ArtStation ↗</a></p>\n    </div>\n    <div class=\"pk-section\" style=\"display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;border-top:1px solid var(--hairline);padding-top:1.4rem\">\n      <p style=\"margin:0;font-size:1.1rem\">Have a project in Unity or Unreal?</p>\n      <div style=\"display:flex;gap:.8rem;flex-wrap:wrap\"><a class=\"btn js-need\" data-need=\"Performance audit\" href=\"/#custom\">Book an audit</a><a class=\"btn ghost\" href=\"/#custom\">Start a project</a></div>\n    </div>\n  </div>\n</section></main>";
---
<Base title="VR & real-time services · Renderly Studio" description="Performance audits, optimization, environments, levels and tech art for Unity and Unreal, for game and VR teams." path="/services">
<Fragment set:html={html} />
</Base>
